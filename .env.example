# Copy to ".env" in THIS folder (next to orchestra_mcp_server.py). Never commit ".env".
# The server reads these from its own process environment or from that file.
# Claude Desktop's sign-in / gateway settings do NOT supply them.

# OpenRouter: GPT Astra, Muse Spark, and the whole decision bench (Jev, Decider, Solar).
OPENROUTER_API_KEY=

# DeepSeek direct API: deepseek-v4-pro, deepseek-v4.1-flash.
DEEPSEEK_API_KEY=

# Zhipu direct API: glm-5.3.
ZHIPU_API_KEY=

# Optional.
# ORCHESTRA_ROUTER_MODE=active          # active (default) | shadow: log the router's ruling only
# ORCHESTRA_DYNAMIC_FLEET=1             # research only; off by default (references/dynamic-fleet.md)
# ORCHESTRA_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
